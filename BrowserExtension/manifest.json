{
  "manifest_version": 3,
  "name": "Himaya Shorts & Reels Guard",
  "version": "1.0.0",
  "description": "Blocks short-form video destinations on websites selected in Himaya Security.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}